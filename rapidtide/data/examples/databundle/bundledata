#!/bin/bash
#
# Build the test data bundles.
#
# There are two of them because GitHub refuses any single file over 100MB, and the
# full size data alone is already close to that.  Keeping the cropped SMALL datasets
# in a second tarball leaves both with room to grow; putting everything in one file
# does not.  The two are fetched together by installtestdata and unpack into the same
# directory, so the split is invisible to anything downstream.

rm -f ../testdatabundle.tgz ../testdatabundlesmall.tgz

xattr -dr com.apple.quarantine ./*.par ./*.json ./*.gz ./*.txt

COPYFILE_DISABLE=1 tar --no-mac-metadata -cvzf ../testdatabundle.tgz \
    fakemotion.par \
    lt_rt.txt \
    lforegressor.txt \
    sub-HAPPYTEST.json \
    sub-HAPPYTEST.nii.gz \
    sub-HAPPYTEST_desc-slicerescardfromfmri_timeseries.json \
    sub-HAPPYTEST_desc-slicerescardfromfmri_timeseries.tsv.gz \
    sub-HAPPYTEST_mask.nii.gz \
    sub-HAPPYTEST_mcf.par \
    sub-HAPPYTEST_smallmask.nii.gz \
    sub-NIRSRAPIDTIDETEST.txt \
    sub-NIRSRAPIDTIDETEST_mask.txt \
    sub-RAPIDTIDETEST.nii.gz \
    sub-RAPIDTIDETEST_brainmask.nii.gz \
    sub-RAPIDTIDETEST_cerebellarmask.nii.gz \
    sub-RAPIDTIDETEST_cifti.ptseries.nii \
    sub-RAPIDTIDETEST_desc-oversampledmovingregressor_timeseries.json \
    sub-RAPIDTIDETEST_desc-oversampledmovingregressor_timeseries.tsv.gz \
    sub-RAPIDTIDETEST_mean.nii.gz \
    sub-RAPIDTIDETEST_nullmask.nii.gz \
    sub-RAPIDTIDETEST_restrictedmask.nii.gz \
    sub-RAPIDTIDETEST_synthseg.nii.gz \
    timecourse1.txt \
    timecourse2.txt \
    tmask.txt \
    tmask3.txt \
    tmask3_exclude.txt \
    tmask_seg1.txt \
    tmask_seg2.txt \
    tmask_seg3.txt

COPYFILE_DISABLE=1 tar --no-mac-metadata -cvzf ../testdatabundlesmall.tgz \
    sub-HAPPYTESTSMALL.json \
    sub-HAPPYTESTSMALL.nii.gz \
    sub-HAPPYTESTSMALL_mask.nii.gz \
    sub-HAPPYTESTSMALL_smallmask.nii.gz \
    sub-RAPIDTIDETESTSMALL.nii.gz \
    sub-RAPIDTIDETESTSMALL_brainmask.nii.gz \
    sub-RAPIDTIDETESTSMALL_cerebellarmask.nii.gz \
    sub-RAPIDTIDETESTSMALL_mean.nii.gz \
    sub-RAPIDTIDETESTSMALL_nullmask.nii.gz \
    sub-RAPIDTIDETESTSMALL_restrictedmask.nii.gz \
    sub-RAPIDTIDETESTSMALL_synthseg.nii.gz
